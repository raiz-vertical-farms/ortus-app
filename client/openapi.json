{
  "openapi": "3.1.0",
  "info": {
    "title": "Raiz API",
    "description": "API for the Raiz platform",
    "version": "1.0.0"
  },
  "paths": {
    "/api/device/create": {
      "post": {
        "operationId": "createDevice",
        "summary": "Register a new device",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Device created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ]
                    }
                  },
                  "required": [
                    "device"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mac_address": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "mac_address",
                  "name"
                ]
              }
            }
          }
        }
      }
    },
    "/api/device/{id}": {
      "delete": {
        "operationId": "deleteDevice",
        "summary": "Delete a device",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Device deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Device not found"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/state": {
      "get": {
        "operationId": "deviceState",
        "summary": "Retrieve the latest state for a specific device",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Device state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        },
                        "created_at": {
                          "type": "number"
                        },
                        "name": {
                          "type": "string"
                        },
                        "mac_address": {
                          "type": "string"
                        },
                        "last_seen": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "online": {
                          "type": "boolean"
                        },
                        "brightness": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "light_on": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "temperature": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "water_empty": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "irrigation_on": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "light_schedule": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "active": {
                                  "type": "boolean"
                                },
                                "start_at": {
                                  "type": "number"
                                },
                                "start_off": {
                                  "type": "boolean"
                                },
                                "minutes_on": {
                                  "type": "number"
                                },
                                "minutes_off": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "active",
                                "start_at",
                                "start_off",
                                "minutes_on",
                                "minutes_off"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "irrigation_schedule": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "active": {
                                  "type": "boolean"
                                },
                                "start_at": {
                                  "type": "number"
                                },
                                "start_off": {
                                  "type": "boolean"
                                },
                                "minutes_on": {
                                  "type": "number"
                                },
                                "minutes_off": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "active",
                                "start_at",
                                "start_off",
                                "minutes_on",
                                "minutes_off"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lan_ip": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lan_ws_port": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "created_at",
                        "name",
                        "mac_address",
                        "last_seen",
                        "online",
                        "brightness",
                        "light_on",
                        "temperature",
                        "water_empty",
                        "irrigation_on",
                        "light_schedule",
                        "irrigation_schedule",
                        "lan_ip",
                        "lan_ws_port"
                      ]
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/history": {
      "get": {
        "operationId": "deviceHistory",
        "summary": "Recent state changes for a device (most recent first)",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "State history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "brightness": {
                            "type": "number"
                          },
                          "light_on": {
                            "type": "boolean"
                          },
                          "irrigation_on": {
                            "type": "boolean"
                          },
                          "temperature": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "water_empty": {
                            "type": "boolean"
                          },
                          "recorded_at": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "brightness",
                          "light_on",
                          "irrigation_on",
                          "temperature",
                          "water_empty",
                          "recorded_at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "history"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/logs": {
      "get": {
        "operationId": "deviceLogs",
        "summary": "Recent debug logs for a device (most recent first)",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Device logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "level": {
                            "type": "string"
                          },
                          "tag": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "recorded_at": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "level",
                          "tag",
                          "message",
                          "recorded_at"
                        ]
                      }
                    }
                  },
                  "required": [
                    "logs"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/all": {
      "get": {
        "operationId": "allDevices",
        "summary": "List devices",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "devices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "created_at": {
                            "type": "number"
                          },
                          "name": {
                            "type": "string"
                          },
                          "mac_address": {
                            "type": "string"
                          },
                          "last_seen": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "online": {
                            "type": "boolean"
                          },
                          "temperature": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "water_empty": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "irrigation_on": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lan_ip": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lan_ws_port": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "created_at",
                          "name",
                          "mac_address",
                          "last_seen",
                          "online",
                          "temperature",
                          "water_empty",
                          "irrigation_on",
                          "lan_ip",
                          "lan_ws_port"
                        ]
                      }
                    }
                  },
                  "required": [
                    "devices"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/device/{id}/light/brightness": {
      "post": {
        "operationId": "setBrightness",
        "summary": "Adjust the brightness of the light",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brightness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "brightness"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/light/schedule": {
      "post": {
        "operationId": "scheduleLight",
        "summary": "Start or pause the light schedule",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": {
                    "type": "boolean"
                  },
                  "minutes_on": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minutes_off": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "active"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/light/schedule/skip": {
      "post": {
        "operationId": "skipLightSchedule",
        "summary": "Skip the current light phase",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/light/schedule/restart": {
      "post": {
        "operationId": "restartLightSchedule",
        "summary": "Restart the light schedule (starts ON phase immediately)",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/irrigation/schedule": {
      "post": {
        "operationId": "scheduleIrrigation",
        "summary": "Start or pause the irrigation schedule",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": {
                    "type": "boolean"
                  },
                  "minutes_on": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minutes_off": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "active"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/irrigation/schedule/skip": {
      "post": {
        "operationId": "skipIrrigationSchedule",
        "summary": "Skip the current irrigation phase",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/device/{id}/irrigation/schedule/restart": {
      "post": {
        "operationId": "restartIrrigationSchedule",
        "summary": "Restart the irrigation schedule (starts watering immediately)",
        "tags": [
          "Devices"
        ],
        "responses": {},
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ]
      }
    },
    "/api/network/my-ip": {
      "get": {
        "operationId": "myIp",
        "summary": "Get my IP address",
        "tags": [
          "Network"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ip": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ip"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/network/local-devices": {
      "get": {
        "operationId": "localDevices",
        "summary": "Get devices that recently announced presence from the same IP",
        "tags": [
          "Devices"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "mac_address": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "mac_address"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "ip",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    }
  },
  "components": {}
}